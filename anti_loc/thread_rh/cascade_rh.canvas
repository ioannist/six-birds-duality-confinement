{
  "nodes": [
    { "id": "rh", "type": "text", "x": -150, "y": 0, "width": 300, "height": 100, "text": "**RH: Riemann Hypothesis**\ntarget conjecture\n*orientation: adequacy (Ξ → 0)*" },

