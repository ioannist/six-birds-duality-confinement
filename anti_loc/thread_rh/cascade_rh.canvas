    { "id": "xi_bc", "type": "text", "x": -850, "y": 200, "width": 300, "height": 100, "color": "2", "text": "**Ξ_BC = B*·Π_Y·B**\nactive parent residual\n(Burnol/Sonine carrier)" },
    { "id": "xi_bc_hecke", "type": "text", "x": 550, "y": 200, "width": 350, "height": 100, "color": "2", "text": "**Ξ_BC_Hecke**\n= K_DD − K_DL·K_LL†·K_LD\nactive sibling parent residual" },

    { "id": "branch_a", "type": "text", "x": -1500, "y": 400, "width": 280, "height": 100, "text": "**Branch A**\nCalkin-bridge lane\ntyped context A_η/K_η" },
