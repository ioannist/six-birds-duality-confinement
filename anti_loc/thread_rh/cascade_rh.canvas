    { "id": "hb1", "type": "text", "x": 480, "y": 380, "width": 320, "height": 70, "color": "5", "text": "**H1**: direct-integral Schur audit  *(open typed obligation)*" },
    { "id": "hb2", "type": "text", "x": 480, "y": 460, "width": 320, "height": 70, "color": "5", "text": "**H2**: Plancherel tail / lower frame  *(open external tail and lower frame)*" },
