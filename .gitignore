# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Editor / OS noise
.DS_Store
*.swp
*.swo

# Lake build artifacts (do not check vendored Foundations' lake builds either)
.lake/
lake-manifest.json
*.olean
*.ilean

# Foundation validator scratch logs (regenerated per run)
**/.validate-logs/

# Per-environment secrets (Zenodo API token, etc.)
.env

# codex CLI internal marker file (zero bytes; per-environment)
/.codex

# Claude Code harness scratch (per-environment)
/.claude/

# LaTeX build artifacts (paper/ and any latex-build subtrees)
build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
