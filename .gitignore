# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Editor / OS noise
.DS_Store
*.swp
*.swo

# Lake build artifacts (do not check vendored Foundations' lake builds either)
.lake/
lake-manifest.json
*.olean
*.ilean

# Foundation validator scratch logs (regenerated per run)
**/.validate-logs/

# Per-environment secrets (Zenodo API token, etc.)
.env
.env.*
!.env.example
!.env.sample
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# Local workflow marker file (zero bytes; per-environment)
/.codex

# Local agent/workflow state
.agents/
.codex/
.agent/
.cursor/
.aider*
AGENTS.md
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
GEMINI.md
CODEX.md

# Local harness scratch (per-environment)
.claude/

# AI conversations, dispatch records, and agent memory
agent-transcripts/
transcripts/
agent-memory/
**/.*session_id*
**/.*conversation_id*

# Internal research/discussion archive; not part of the public paper support surface.
# These paths may still be tracked until repository history is cleaned separately.
anti_loc/
PLAN_mechanization.md
reviews/
review/
**/.*thread_id*
lean/*RUNBOOK.md
lean/*kickoff.md
scripts/build_*_prompt.py
# Local cross-repository review tooling (depends on the private review archive)
scripts/audit_triad_dependency_graph.py
scripts/extract_triad_dependencies.lean.in
scripts/extract_triad_dependency_snapshot.py
scripts/fresh_triad_source_review.py
scripts/inventory_triad_lean_review.py
paper/writing-plan.md
paper/**/writing-plan.md
paper/**/notes/drafting-plan.md
paper/rh/aor_thread.md
paper/rh/aor_review.md

# Private paper-planning notes; retain the public validation inputs
/paper/notes/*
!/paper/notes/statements-of-record.md
!/paper/notes/statements-of-record.yml
/paper/rh/notes/
/paper/duality_confinement/notes/

# Local Zenodo v3 draft metadata, upload receipts, and validation records
/paper/rh/submission/zenodo-v3-*.json
/paper/duality_confinement/submission/zenodo-v3-*.json

# LaTeX build artifacts (paper/ and any latex-build subtrees)
build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
